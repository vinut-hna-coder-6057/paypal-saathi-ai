<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:contentDescription="@string/app_name"
            android:text="@string/app_name"
            android:textColor="#172033"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/tagline"
            android:textColor="#526078"
            android:textSize="16sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="#E4ECFA"
            android:padding="14dp"
            android:text="@string/privacy_banner"
            android:textColor="#23314D"
            android:textSize="14sp" />

        <Button
            android:id="@+id/openAccessibilitySettingsButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:contentDescription="@string/open_accessibility_settings"
            android:minHeight="48dp"
            android:text="@string/open_accessibility_settings" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/accessibility_how_to"
            android:textColor="#526078"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/serviceStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/accessibility_disabled"
            android:textColor="#172033"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/backendStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/backend_checking"
            android:textColor="#35435B"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/currentCategory"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/detected_category_waiting"
            android:textColor="#172033"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/emptyState"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="#FFF6E8"
            android:padding="12dp"
            android:text="@string/empty_state"
            android:textColor="#5C4A2A"
            android:textSize="14sp"
            android:visibility="gone" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/classifier_note"
            android:textColor="#526078"
            android:textSize="12sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="#FFFFFF"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/guidanceTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/saathi_guidance"
                android:textColor="#172033"
                android:textSize="20sp"
                android:textStyle="bold" />

            <ProgressBar
                android:id="@+id/guidanceLoading"
                style="?android:attr/progressBarStyleSmall"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:contentDescription="@string/loading_guidance"
                android:visibility="gone" />

            <TextView
                android:id="@+id/guidanceSteps"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:lineSpacingExtra="4dp"
                android:text="@string/contacting_server"
                android:textColor="#35435B"
                android:textSize="15sp" />

            <Button
                android:id="@+id/refreshGuidanceButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:contentDescription="@string/refresh_guidance"
                android:minHeight="48dp"
                android:text="@string/refresh_guidance" />

            <Button
                android:id="@+id/retryGuidanceButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:contentDescription="@string/retry_guidance"
                android:minHeight="48dp"
                android:text="@string/retry_guidance"
                android:visibility="gone" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/ask_saathi_heading"
            android:textColor="#172033"
            android:textSize="20sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/questionInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:autofillHints=""
            android:hint="@string/question_hint"
            android:importantForAutofill="no"
            android:inputType="textCapSentences|textMultiLine"
            android:maxLength="500"
            android:minHeight="56dp"
            android:padding="12dp" />

        <Button
            android:id="@+id/askSaathiButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:contentDescription="@string/ask_saathi"
            android:minHeight="48dp"
            android:text="@string/ask_saathi" />

        <ProgressBar
            android:id="@+id/questionLoading"
            style="?android:attr/progressBarStyleSmall"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:contentDescription="@string/preparing_answer"
            android:visibility="gone" />

        <TextView
            android:id="@+id/questionResult"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:autoLink="web"
            android:background="#FFFFFF"
            android:linksClickable="true"
            android:padding="14dp"
            android:text="@string/answers_placeholder"
            android:textColor="#35435B"
            android:textSize="15sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/recent_events"
            android:textColor="#172033"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/eventLog"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="#FFFFFF"
            android:minHeight="80dp"
            android:padding="14dp"
            android:text="@string/no_screen_events"
            android:textColor="#526078"
            android:textSize="14sp" />

    </LinearLayout>
</ScrollView>
