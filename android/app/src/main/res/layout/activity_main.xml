<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F7FB"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="PayPal Saathi AI"
            android:textColor="#172033"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Simple, step-by-step payment guidance"
            android:textColor="#526078"
            android:textSize="16sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="#E4ECFA"
            android:padding="14dp"
            android:text="Privacy first: this prototype does not click payment buttons or make payments. Never enter passwords, PINs, OTPs, or card details into Saathi."
            android:textColor="#23314D"
            android:textSize="14sp" />

        <Button
            android:id="@+id/openAccessibilitySettingsButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Open Accessibility Settings" />

        <TextView
            android:id="@+id/serviceStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Accessibility service: checking"
            android:textColor="#172033"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/currentCategory"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Detected category: waiting for screen event"
            android:textColor="#172033"
            android:textSize="16sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="#FFFFFF"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/guidanceTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Saathi guidance"
                android:textColor="#172033"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/guidanceSteps"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:lineSpacingExtra="4dp"
                android:text="Guidance will appear here."
                android:textColor="#35435B"
                android:textSize="15sp" />

            <Button
                android:id="@+id/refreshGuidanceButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Refresh Guidance" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Ask Saathi"
            android:textColor="#172033"
            android:textSize="20sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/questionInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="Example: How do I find my transactions?"
            android:inputType="textCapSentences|textMultiLine"
            android:maxLength="500"
            android:minHeight="56dp"
            android:padding="12dp" />

        <Button
            android:id="@+id/askSaathiButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Ask Saathi" />

        <TextView
            android:id="@+id/questionResult"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="#FFFFFF"
            android:padding="14dp"
            android:text="Answers will appear here."
            android:textColor="#35435B"
            android:textSize="15sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Recent screen events"
            android:textColor="#172033"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/eventLog"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="#FFFFFF"
            android:minHeight="80dp"
            android:padding="14dp"
            android:text="No screen events detected yet."
            android:textColor="#526078"
            android:textSize="14sp" />

    </LinearLayout>
</ScrollView>
