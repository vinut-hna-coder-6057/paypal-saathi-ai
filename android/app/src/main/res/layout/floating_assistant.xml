<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">

    <TextView
        android:id="@+id/floatingAssistantButton"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:background="@drawable/floating_assistant_button"
        android:clickable="true"
        android:contentDescription="@string/floating_assistant_open"
        android:focusable="true"
        android:gravity="center"
        android:text="@string/floating_assistant_initial"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        android:textStyle="bold" />

    <LinearLayout
        android:id="@+id/floatingAssistantPanel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/floating_assistant_panel"
        android:orientation="vertical"
        android:padding="16dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/floating_assistant_title"
                    android:textColor="#172033"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/floatingAssistantConnection"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/backend_checking"
                    android:textColor="#526078"
                    android:textSize="12sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/floatingAssistantMinimize"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:clickable="true"
                android:contentDescription="@string/floating_assistant_minimize"
                android:focusable="true"
                android:gravity="center"
                android:text="@string/floating_assistant_minimize_symbol"
                android:textColor="#35435B"
                android:textSize="24sp" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/floating_assistant_disclosure"
            android:textColor="#526078"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/floatingAssistantCategory"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="#E4ECFA"
            android:padding="10dp"
            android:text="@string/floating_assistant_unknown"
            android:textColor="#23314D"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/floatingAssistantContext"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/floating_assistant_unknown_explanation"
            android:textColor="#35435B"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/floatingAssistantSuggestion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/floating_assistant_suggestion"
            android:textColor="#2457C5"
            android:textSize="13sp" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="8dp"
            android:layout_weight="1"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <ProgressBar
                    android:id="@+id/floatingAssistantLoading"
                    style="?android:attr/progressBarStyleSmall"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:contentDescription="@string/preparing_answer"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/floatingAssistantAnswer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:autoLink="web"
                    android:background="#F5F7FB"
                    android:linksClickable="true"
                    android:padding="12dp"
                    android:text="@string/floating_assistant_empty_answer"
                    android:textColor="#35435B"
                    android:textSize="14sp" />

                <Button
                    android:id="@+id/floatingAssistantRetry"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:text="@string/retry_guidance"
                    android:visibility="gone" />
            </LinearLayout>
        </ScrollView>

        <EditText
            android:id="@+id/floatingAssistantQuestion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:autofillHints=""
            android:hint="@string/question_hint"
            android:importantForAutofill="no"
            android:inputType="textCapSentences|textMultiLine"
            android:maxLength="500"
            android:minHeight="48dp"
            android:padding="10dp" />

        <Button
            android:id="@+id/floatingAssistantSend"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="@string/ask_saathi" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/floating_assistant_safety"
            android:textColor="#526078"
            android:textSize="11sp" />
    </LinearLayout>
</FrameLayout>
