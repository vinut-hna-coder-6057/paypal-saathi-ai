<?xml version="1.0" encoding="utf-8"?>
<!--
  Development cleartext is limited to emulator/host loopback addresses.
  Production builds should use HTTPS (see BuildConfig.API_BASE_URL for release).
  For a physical device: adb reverse tcp:3000 tcp:3000 then use http://127.0.0.1:3000
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />

    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">10.0.3.2</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>
