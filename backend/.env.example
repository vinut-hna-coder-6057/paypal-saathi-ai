PORT=3000
HOST=127.0.0.1
NODE_ENV=development
CORS_ORIGINS=http://localhost:3000
RATE_LIMIT_PER_MINUTE=60
# Configure these together for production or any non-loopback HOST.
# AUTH_PUBLIC_KEY_PEM=-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----
# AUTH_ISSUER=https://identity.example.com/
# AUTH_AUDIENCE=paypal-saathi-api
