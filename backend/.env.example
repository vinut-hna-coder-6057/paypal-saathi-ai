PAYPAL_EMBEDDING_MODEL=Xenova/all-MiniLM-L6-v2
PAYPAL_KB_DB_PATH=./data/paypal-knowledge.sqlite
PAYPAL_RAG_MIN_SIMILARITY=0.45
PAYPAL_LLM_TIMEOUT_MS=45000
PAYPAL_OLLAMA_KEEP_ALIVE=5m
